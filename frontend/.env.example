# ---------------------------------------------------------------------------
# AgriDirect Frontend Environment Variables
# ---------------------------------------------------------------------------
# Note: Variables prefixed with VITE_ are embedded into the client build.
# NEVER put secrets, private keys, or passwords here.

# Backend API base URL (defaults to /api/v1 via Vite development proxy)
VITE_API_BASE_URL=/api/v1

# Application brand title
VITE_APP_TITLE=AgriDirect
