# AgriDirect backend — environment variable template
#
# HOW TO USE
# ----------
# 1. Copy this file to a new file named exactly ".env" in the same directory:
#
#      Copy-Item backend\.env.example backend\.env
#
# 2. Open backend\.env and replace every placeholder value with your real
#    local values.  In particular:
#      - Replace YOUR_PASSWORD with the password of the agridirect_app database role.
#      - Replace the SECRET_KEY placeholder with a long random string.
#        Generate one with:
#          python -c "import secrets; print(secrets.token_hex(32))"
#
# 3. Never commit the real backend\.env file.
#    The .gitignore already excludes it; this .env.example file is safe to commit.
#
# NOTE: All variable names are uppercase.  The application reads them
# case-insensitively, but uppercase is the convention.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Application environment
# Recognised values: development | testing | production
# ---------------------------------------------------------------------------
APP_ENV=development


# ---------------------------------------------------------------------------
# Database connection URL
#
# Format:
#   postgresql+psycopg://ROLE:PASSWORD@HOST:PORT/DATABASE
#
# The scheme "postgresql+psycopg" selects the synchronous Psycopg 3 driver
# used by this project.  Do not use "postgresql+asyncpg" or plain
# "postgresql" here.
#
# Replace YOUR_PASSWORD with the password of the agridirect_app role.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://agridirect_app:YOUR_PASSWORD@localhost:5432/agridirect_db


# ---------------------------------------------------------------------------
# Secret key (used to sign JWT tokens, implemented in Phase 2)
#
# Generate a suitable value:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# This value must be at least 32 characters long.
# Never share or commit the real value.
# ---------------------------------------------------------------------------
SECRET_KEY=replace-this-with-a-long-random-secret-key-at-least-32-chars
