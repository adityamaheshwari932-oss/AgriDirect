# AgriDirect backend — environment variable template
#
# HOW TO USE
# ----------
# 1. Copy this file to a new file named exactly ".env" in the same directory:
#
#      Copy-Item backend\.env.example backend\.env
#
# 2. Open backend\.env and replace every placeholder value with your real
#    local values.  In particular:
#      - Replace YOUR_PASSWORD with the password of the agridirect_app database role.
#      - Replace the SECRET_KEY placeholder with a long random string.
#        Generate one with:
#          python -c "import secrets; print(secrets.token_hex(32))"
#
# 3. Never commit the real backend\.env file.
#    The .gitignore already excludes it; this .env.example file is safe to commit.
#
# NOTE: All variable names are uppercase.  The application reads them
# case-insensitively, but uppercase is the convention.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Application environment
# Recognised values: development | testing | production
# ---------------------------------------------------------------------------
APP_ENV=development


# ---------------------------------------------------------------------------
# Database connection URL
#
# Format:
#   postgresql+psycopg://ROLE:PASSWORD@HOST:PORT/DATABASE
#
# The scheme "postgresql+psycopg" selects the synchronous Psycopg 3 driver
# used by this project.  Do not use "postgresql+asyncpg" or plain
# "postgresql" here.
#
# Replace YOUR_PASSWORD with the password of the agridirect_app role.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://agridirect_app:YOUR_PASSWORD@localhost:5432/agridirect_db


# ---------------------------------------------------------------------------
# Secret key (used to sign JWT tokens, implemented in Phase 2)
#
# Generate a suitable value:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# This value must be at least 32 characters long and must not be REPLACE_ME.
# The placeholder below is intentionally short so that copying this file
# without replacing it causes a clear startup error rather than running with
# a publicly known secret.
# Never share or commit the real value.
# ---------------------------------------------------------------------------
SECRET_KEY=REPLACE_ME


# ---------------------------------------------------------------------------
# JWT / Authentication configuration
# ---------------------------------------------------------------------------
# Algorithm used for signing JWT tokens. Supported: HS256, HS384, HS512
JWT_ALGORITHM=HS256

# Access token expiration in minutes (default: 60 minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate limiting for sensitive authentication endpoints (login)
# Set to false to disable rate limiting (default: true)
ENABLE_AUTH_RATE_LIMIT=true

# Maximum login attempts allowed per client IP within the rate limit window (default: 5)
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5

# Duration of the sliding rate limit window in seconds (default: 60)
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Document Storage (Verification Evidence)
# ---------------------------------------------------------------------------
# Storage directory for private verification uploads (default: uploads/verification)
UPLOAD_DIR=uploads/verification

# Maximum upload size in bytes (default: 10485760 / 10MB)
MAX_UPLOAD_SIZE_BYTES=10485760

# ---------------------------------------------------------------------------
# Listing Media Storage (Produce Catalog)
# ---------------------------------------------------------------------------
# Storage directory for produce listing photographic assets (default: uploads/listings)
LISTING_IMAGES_DIR=uploads/listings


# ---------------------------------------------------------------------------
# Operational Email Notifications (optional feature flag)
# ---------------------------------------------------------------------------
# Set to true to enable operational email alerts (default: false)
ENABLE_EMAIL_NOTIFICATIONS=false

# SMTP Server details (only used when ENABLE_EMAIL_NOTIFICATIONS=true)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=notifications@agridirect.example.com
# SMTP_PASSWORD=YOUR_SMTP_PASSWORD
# SMTP_FROM_EMAIL=notifications@agridirect.example.com
