# AgriDirect Platform — Root Environment Variable Template
#
# HOW TO USE:
# 1. Copy this file to .env:
#      cp .env.example .env (Linux/macOS) or Copy-Item .env.example .env (Windows PowerShell)
# 2. Update default secrets and credentials before launching containers.
# 3. Launch the platform:
#      docker compose up --build -d

# Application Environment (development | testing | production)
APP_ENV=production

# Database Configuration (PostgreSQL 16+)
POSTGRES_DB=agridirect_db
POSTGRES_USER=agridirect_app
POSTGRES_PASSWORD=postgres_secure_password_replace_in_prod
POSTGRES_PORT=5432

# Backend API Configuration
BACKEND_PORT=8000
# Generate 32+ char secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate Limiting
ENABLE_AUTH_RATE_LIMIT=true
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
